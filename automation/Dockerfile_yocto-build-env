FROM ubuntu:18.04 AS yocto-build-env

ARG DEBIAN_FRONTEND=noninteractive

# bionic's archive mirror has been intermittently dropping/corrupting
# individual package fetches mid-apt-get-install (a different package each
# retry, "Undetermined Error") - likely an EOL-archive mirror flakiness
# issue, not a real missing-package problem. Force IPv4 and add retries.
RUN echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4 && \
    echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/99retries

# Install the following utilities (required by poky)
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends build-essential chrpath curl diffstat gcc-multilib gawk git-core locales zstd liblz4-tool \
    texinfo unzip wget xterm cpio file python python3 openssh-client iputils-ping iproute2 \
    python3-distutils python3-pip python3-pexpect python3-git python3-jinja2 python3-subunit \
    gawk socat xz-utils libegl1-mesa libsdl1.2-dev pylint3 mesa-common-dev debianutils screen rsync sharutils \
    && rm -rf /var/lib/apt/lists/*

# Set the locale to UTF-8 for bulding with poky morty
RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8

# Additional host packages required by balena
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends apt-transport-https iptables iproute2 procps uidmap gnupg ca-certificates && rm -rf /var/lib/apt/lists/*
# bionic's distro nodejs/npm packages are unusably old (predate a standalone
# npm package) - pull Node from NodeSource's own bionic repo instead, same as
# this Dockerfile did historically (last confirmed live: node_8.x/bionic).
# (gnupg isn't preinstalled on current ubuntu:18.04 pulls, unlike whenever
# this file last worked - apt-key needs it explicitly now. NodeSource has also
# since rotated their signing key, so the current /gpgkey/nodesource.gpg.key
# doesn't match this archived repo's old InRelease signature - mark this one
# repo [trusted=yes] rather than chase down a dead legacy key.)
ENV NODE_VERSION=node_8.x
ENV DISTRO=bionic
RUN echo "deb [trusted=yes] https://deb.nodesource.com/$NODE_VERSION $DISTRO main" | tee /etc/apt/sources.list.d/nodesource.list &&\
    echo "deb-src [trusted=yes] https://deb.nodesource.com/$NODE_VERSION $DISTRO main" | tee -a /etc/apt/sources.list.d/nodesource.list
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends jq nodejs sudo && rm -rf /var/lib/apt/lists/*

# Additional host packages required by various BSP layers
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends dos2unix && rm -rf /var/lib/apt/lists/*

# Install docker from Docker's official APT repo, pinned to the newest (and
# last ever published) docker-ce build for bionic - Docker dropped Ubuntu
# 18.04 support after this version, so there's no floating "latest" to track
# here the way the jammy Dockerfile does.
# https://download.docker.com/linux/ubuntu/dists/bionic/pool/stable/amd64/
# https://docs.docker.com/engine/install/ubuntu/
RUN install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc && \
    chmod a+r /etc/apt/keyrings/docker.asc && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu bionic stable" > /etc/apt/sources.list.d/docker.list

ENV DOCKER_CE_VERSION=24.0.2
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends e2fsprogs xfsprogs git kmod "docker-ce=5:${DOCKER_CE_VERSION}-1~ubuntu.18.04~bionic" "docker-ce-cli=5:${DOCKER_CE_VERSION}-1~ubuntu.18.04~bionic" containerd.io && \
    rm -rf /var/lib/apt/lists/*
VOLUME /var/lib/docker

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# balena-cli install skipped here: current balena-cli's bundled Node binary
# needs glibc >= 2.28, bionic ships 2.27 (one release short) - it isn't used
# by barys/bitbake itself (only by deploy-side scripts), so it's not needed
# to validate the Yocto build on this base image. Re-add with an older,
# glibc-2.27-compatible balena-cli pin if this image needs to deploy too.

COPY include/balena-docker.inc /
COPY entry_scripts/prepare-and-start.sh /

WORKDIR /work
